# Copy this file to .env and fill in the values. .env is not in git, so real
# values stay out of the repository.

# Server of the Paola web app, without the /paola path. On a real phone use
# the LAN IP of the machine running it (localhost only works in a simulator);
API_URL=http://localhost:3000

# Receives the mails written via the contact button
# Leave it empty to hide the button.
CONTACT_EMAIL=contact@example.com
